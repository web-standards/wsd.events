wsd.events {
	root * /opt/sites/wsd.events/public
	tls wst@web-standards.ru
	import common wsd.events

	header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

	handle_errors {
		@404 expression {http.error.status_code} == 404
		handle @404 {
			rewrite * /404/
			file_server
		}
	}
}

www.wsd.events {
	tls wst@web-standards.ru
	redir https://wsd.events{uri} permanent
}
